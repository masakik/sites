{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravellegends/pt-br-validator": "^13.0",
        "rap2hpoutre/laravel-log-viewer": "3.1.0 as 2.5.0",
        "uspdev/laravel-tools": "^1.6",
        "uspdev/laravel-usp-theme": "^2.0",
        "uspdev/laravel-usp-validators": "^1.0",
        "uspdev/laravel-replicado": "^1",
        "uspdev/senhaunica-socialite": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.0",
        "uspdev/laravel-usp-faker": "^1.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --provider='Uspdev\\UspTheme\\ServiceProvider' --tag=assets --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd":[
            "@wp-cli-update"
        ],
        "wp-cli-update": [
            "./app/Manager/Wordpress/wp cli update --yes"
        ]
    }
}
